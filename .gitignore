# Datasets — the actual images are never redistributed via GitHub (see DATASET.md).
# Small, image-free metadata (manifests, hashes, labels) is tracked deliberately —
# it's what makes the experiment reproducible without redistributing the dataset.
data/*
!data/splits/
!data/processed/
!data/final/
data/processed/*
!data/processed/pvpanel_audit_with_clusters.csv
data/final/*
!data/final/dataset_statistics.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Environments
venv/
.venv/
env/

# Model artifacts (large binaries — tracked separately once training starts)
checkpoints/
*.pt
*.pth
*.h5
# Exception: the deployment artifact is small (406 KB, optimizer state stripped) and
# must ship so a fresh clone can run the Streamlit app without a training checkpoint.
!models/solarguard_baseline_v1.pt

# Local tooling / assistant working files — not part of the project
.claude/

# OS
.DS_Store
Thumbs.db

# Private engineering notes. Kept locally, deliberately not published: the raw decision
# log contains blunt working assessments of third-party datasets and papers.
PLANNING.md

# Secrets
.env
